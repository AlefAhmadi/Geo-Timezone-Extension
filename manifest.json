{
  "manifest_version": 3,
  "name": "Geo & Timezone Changer (تغییر موقعیت و زمان)",
  "version": "1.4.0",
  "description": "تغییر دستی موقعیت مکانی GPS، زبان محلی و منطقه زمانی سیستم برای دور زدن محدودیت‌ها و تست نرم‌افزار",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "proxy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Geo & Timezone Changer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}